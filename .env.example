# Copy to .env and adjust as needed. Do not commit real secrets.

# Demo site credentials (public demo defaults)
BOT_USERNAME=demo
BOT_PASSWORD=demo

# Target page for the ArCaptcha Selenium bot
TARGET_URL=https://demo.arcaptcha.co

# Database
# Docker Compose overrides this to sqlite:////data/runs.db (volume).
# Local desktop runs typically use:
# DATABASE_URL=sqlite:///./data/runs.db
DATABASE_URL=sqlite:////data/runs.db

# Selenium remote WebDriver (optional classic Grid path)
# Leave empty when using DRIVER_MODE=uc (recommended for local + Docker/server).
SELENIUM_REMOTE_URL=

# Optional: override Chrome binary (Docker sets google-chrome-stable)
# CHROME_BINARY=/usr/bin/google-chrome-stable

# Timeouts (seconds)
PAGE_LOAD_TIMEOUT=45
CAPTCHA_WAIT_TIMEOUT=30
LOGIN_WAIT_TIMEOUT=20

# Stealth / anti-block helpers (bonus)
BOT_STEALTH=true
HUMANIZE_DELAYS=true

# Driver mode:
#   uc     = SeleniumBase UC Mode (recommended — used by Docker Compose and local)
#   remote = classic Selenium Remote/local WebDriver (higher ArCaptcha block rate)
DRIVER_MODE=uc
