# Copy to .env and adjust as needed. Do not commit real secrets.

# Demo site credentials (public demo defaults)
BOT_USERNAME=demo
BOT_PASSWORD=demo

# Target page for the ArCaptcha Selenium bot
TARGET_URL=https://demo.arcaptcha.co

# Database (SQLite file is mounted as a Docker volume for persistence)
DATABASE_URL=sqlite:////data/runs.db

# Selenium remote WebDriver (Docker Compose sets this automatically)
# Leave empty to use a local ChromeDriver on the host.
SELENIUM_REMOTE_URL=http://chrome:4444/wd/hub

# Optional: override Chrome binary when running locally
# CHROME_BINARY=

# Timeouts (seconds)
PAGE_LOAD_TIMEOUT=45
CAPTCHA_WAIT_TIMEOUT=30
LOGIN_WAIT_TIMEOUT=20

# Stealth / anti-block helpers (bonus)
BOT_STEALTH=true
HUMANIZE_DELAYS=true

# Driver mode:
#   uc     = SeleniumBase UC Mode (best anti-block on desktop; needs local Chrome)
#   remote = classic Selenium Remote/local WebDriver (used by Docker Compose)
DRIVER_MODE=uc